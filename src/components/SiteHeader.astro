<header class="head">
  <div class="eyebrow">Food-first field map</div>
  <div class="titlerow">
    <div class="title disp">Tim <span class="amp">&amp;</span> Marisa · Korea</div>
    <div class="toolbtns">
      <button class="railtoggle on" id="railToggle" title="Toggle subway lines">🚇 Rail</button>
      <button class="nighttoggle" id="nightToggle" title="Toggle night mode">☀️ Day</button>
      <div class="badge">AUG 29 — SEP 12 · 2026</div>
    </div>
  </div>
  <div class="viewswitch" id="viewswitch">
    <button class="vs-btn on" id="vsMap" data-view="map" aria-pressed="true">🗺️ Map</button>
    <button class="vs-btn" id="vsList" data-view="list" aria-pressed="false">📋 List <span class="vs-ct" id="vsCount"></span></button>
  </div>
  <div class="tabs" id="tabs"></div>
</header>