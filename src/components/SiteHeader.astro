---
import { icon } from "../lib/icons.js";
const base = import.meta.env.BASE_URL;
---
<header class="head">
  <div class="eyebrow">Food-first field map</div>
  <div class="titlerow">
    <div class="title disp">Tim <span class="amp">&amp;</span> Marisa · Korea</div>
    <div class="toolbtns">
      <!-- icon and label are separate spans because the phone hides the labels: see
           client/toolbtn.js. aria-label carries the meaning either way. The icon is
           drawn here as well as set from the script so the first paint is not four
           empty squares waiting for the bundle. -->
      <button class="railtoggle on" id="railToggle" title="Toggle subway lines" aria-label="Toggle subway lines"><span class="tb-i" set:html={icon("rail")} /><span class="tb-l">Rail</span></button>
      <button class="railtoggle" id="meToggle" title="Show where you are and how far things are" aria-label="Show where you are"><span class="tb-i" set:html={icon("me")} /><span class="tb-l">Me</span></button>
      <button class="railtoggle" id="offlineToggle" title="Download this leg's map tiles so the map works with no signal" aria-label="Save this leg's map for offline"><span class="tb-i" set:html={icon("offline")} /><span class="tb-l">Offline</span></button>
      <button class="nighttoggle" id="nightToggle" title="Toggle night mode" aria-label="Toggle night mode"><span class="tb-i" set:html={icon("day")} /><span class="tb-l">Day</span></button>
      <div class="badge">AUG 29 — SEP 12 · 2026</div>
    </div>
  </div>
  <div class="viewswitch" id="viewswitch">
    <button class="vs-btn on" id="vsMap" data-view="map" aria-pressed="true"><Fragment set:html={icon("map")} /> Map</button>
    <button class="vs-btn" id="vsList" data-view="list" aria-pressed="false"><Fragment set:html={icon("list")} /> List <span class="vs-ct" id="vsCount"></span></button>
  </div>
  <!-- The way to the cheat sheet, and it lives here rather than in .toolbtns for a
       measured reason: at 390px four icon toggles already take ~181px of the title row
       and a fifth wraps the title, which is the defect the offline work shipped once
       already. This row has room — it scrolls sideways on a phone — and a thumb is
       using it anyway. Outside #tabs because tabs.js appends the legs into that. -->
  <div class="tabrow">
    <div class="tabs" id="tabs"></div>
    <a class="tab tabout" href={`${base}phrases.html`} title="Korean phrases, said out loud">
      <span class="tab-l">Korean <Fragment set:html={icon("next")} /></span>
      <span class="tab-d">cheat sheet</span>
    </a>
  </div>
</header>
