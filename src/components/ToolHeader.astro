---
import { icon } from "../lib/icons.js";

/* The header every tool page wears: the map's own, with what a page that has no map has
   no use for taken out — no leg tabs, no map/list switch, no rail, me or offline toggle.
   What is left is where you are, the two nav triggers and the theme.

   It is shared rather than copied because there are two of these pages now (phrases and
   money) and a third would have been a third copy. The title keeps its class because
   client/palette.js arms the five-tap panel on `.title`, and a palette is worth judging
   here too.

   There is no eyebrow. "Say it like it's spelled" sat above the cheat sheet for a while
   and said nothing the page did not: the column is right there, in the biggest type on
   the screen, spelled the way you say it. A tagline that restates the thing under it is
   a line of header room — the scarcest room on this page — spent on nothing. */
interface Props { lead: string; tail: string; tool: string; toolLabel: string; toolIcon: string }
const { lead, tail, tool, toolLabel, toolIcon } = Astro.props;
---
<header class="head">
  <div class="titlerow">
    <div class="title disp">{lead} <span class="amp">·</span> {tail}</div>
    <div class="toolbtns">
      <button class="nighttoggle" id="nightToggle" title="Toggle night mode" aria-label="Toggle night mode"><span class="tb-i" set:html={icon("day")} /><span class="tb-l">Day</span></button>
    </div>
  </div>
  <!-- Two triggers, two questions: where the map is pointed, and which tool you are in.
       See client/nav.js for why those stopped sharing one menu. On a tool page the city
       trigger opens the map at that city, which is also the way back — a third "back"
       button beside these two would be 44px spent on something already answered. -->
  <div class="navrow">
    <button class="navtrig" id="navTrig" aria-haspopup="dialog" aria-expanded="false" aria-label="Open the map at a city">
      <span><span class="nv-l">Seoul</span><span class="nv-d"></span></span>
      <Fragment set:html={icon("chevron")} />
    </button>
    <button class="navtrig tool" id="toolTrig" data-tool={tool} aria-haspopup="dialog" aria-expanded="false" aria-label="Switch tool">
      <span class="nv-ic" set:html={icon(toolIcon)} />
      <span class="nv-l">{toolLabel}</span>
      <Fragment set:html={icon("chevron")} />
    </button>
  </div>
</header>
