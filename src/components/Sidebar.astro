<aside class="side" id="side" data-sidetab="places">
  <div class="sidetabs" id="sidetabs">
    <button class="sidetab on" id="tabPlaces" aria-pressed="true">📋 Places</button>
    <button class="sidetab" id="tabPlan" aria-pressed="false">🗓️ Plan <span class="st-ct" id="planCount"></span></button>
  </div>
  <div class="sum">
    <div class="sum-n"><b id="shownCount">40</b> spots · <span id="hoodCount">10</span> neighborhoods</div>
    <div class="sum-sub" id="sumSub"></div>
  </div>
  <div class="searchwrap">
    <input class="searchbox" id="search" type="search" autocomplete="off" spellcheck="false"
           placeholder="Search spots, notes, neighbourhoods" aria-label="Search spots" />
    <button class="searchclear" id="searchClear" title="Clear" aria-label="Clear search">✕</button>
  </div>
  <div class="legend" id="legend"></div>
  <div class="list" id="list"></div>
  <div class="planpane" id="planpane"></div>
</aside>