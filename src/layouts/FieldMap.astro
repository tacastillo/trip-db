---
/* The map page's half of the shell: Leaflet, and the boot module that drives it.
   Everything else — tokens, fonts, the theme metas, <html>/<body> — is Shell.astro,
   which the phrase page uses on its own. Nothing here may be imported by a page that
   has no map: client/main.js dereferences the map page's own markup as it evaluates. */
import Shell from "./Shell.astro";

const base = import.meta.env.BASE_URL;
---
<Shell title="Tim &amp; Marisa · Korea — Seoul field map">
  <link slot="head" rel="stylesheet" href={`${base}vendor/leaflet/leaflet.css`} />
  <slot />

  <!-- Leaflet ships in this repo, so there is no CDN to fall back to and no reason to
       wait: a classic script here runs before the deferred module that needs window.L. -->
  <script is:inline src={`${base}vendor/leaflet/leaflet.js`}></script>
  <script>import "../client/main.js";</script>
</Shell>
